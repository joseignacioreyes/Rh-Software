# =====================================================================
# Variables de entorno de RH Software
# ---------------------------------------------------------------------
# Para trabajar en tu computador: copia este archivo como .env.local y
# completa los valores. En Vercel se cargan en Settings → Environment
# Variables. NUNCA subas .env.local a GitHub ni pegues claves en el chat.
#
# Prefijo NEXT_PUBLIC_: el valor se ve en el navegador (no es secreto).
# Sin ese prefijo: solo lo ve el servidor (secreto).
# =====================================================================

# --- Sitio -----------------------------------------------------------
# URL pública definitiva (por ejemplo https://rhsoftware.cl). Se usa en
# los links al compartir. Si queda vacía, en Vercel se usa la URL de la
# versión de prueba y en tu computador http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Número de soporte y ventas de RH Software para los links wa.me
# (sin "+" ni espacios). Fase 0.
NEXT_PUBLIC_WHATSAPP_SOPORTE=56977766584

# --- Supabase (base de datos, inicio de sesión y archivos) — Fase 1 ---
# Supabase → tu proyecto → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon": se puede ver en el navegador; la seguridad la dan
# las reglas de Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: salta las reglas de seguridad. Solo para el servidor y scripts
# (por ejemplo npm run seed:demo). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Correos transaccionales (Resend) — Fase 1 ------------------------
# resend.com → API Keys. Para el segundo factor por correo y avisos.
RESEND_API_KEY=
# Remitente de los correos, por ejemplo "RH Software <no-responder@rhsoftware.cl>".
# Requiere verificar el dominio en Resend.
CORREO_REMITENTE=

# --- API de Claude (lectura de documentos con IA) — Fases 3 y 7 -------
# console.anthropic.com → API Keys. SECRETA.
ANTHROPIC_API_KEY=

# --- WhatsApp Business Cloud API (Meta) — Fase 7, solo si se aprueba ---
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
